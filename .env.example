# Copie para o painel do Railway (aba Variables). NAO comite segredos.

# --- Millennium (API 6017, Basic auth) ---
MILLENNIUM_URL=http://rotaextrema.millenniumhosting.com.br:6017/api/millenium_eco
MILLENNIUM_USER=integracao
MILLENNIUM_PASS=coloque_a_senha_aqui
VITRINE=301

# --- canal-ml (destino do push; os endpoints ja existem) ---
CANAL_BASE=https://sistema.wolfattack.com.br/projeto/canal-ml
ERP_PUSH_TOKEN=mesmo_valor_do_ERP_PUSH_TOKEN_do_canal

# --- Opcionais ---
# Liga o worker de pedidos (criar/aprovar/colher). Padrão do código já é 1.
WORKER_ENABLED=1
# Campo de saldo: 'saldo' (piloto) ou 'saldo_vitrine_sem_reserva' (real sem reserva)
SALDO_FIELD=saldo
# 1 = so loga, nao empurra (use no primeiro teste)
DRY_RUN=1
BATCH_SIZE=300
MAX_PAGES=50
HTTP_TIMEOUT=60
